# Edamam Recipe API — https://developer.edamam.com/
EDAMAM_APP_ID=your_app_id_here
EDAMAM_APP_KEY=your_app_key_here

# Auth.js — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Vercel KV — required for cross-device persistence
# Get from Vercel Dashboard → Storage → your KV database
KV_REST_API_URL=your_kv_url
KV_REST_API_TOKEN=your_kv_token

# LangSmith tracing (optional) — https://smith.langchain.com
# Get API key from LangSmith Dashboard → Settings → API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=whats-for-dinner
# Internal flag used by the app to enable wrapSDK
LANGSMITH_TRACING_V2=true
